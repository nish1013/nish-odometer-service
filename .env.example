# Copy to .env and fill in. .env is git-ignored.
# A variable set in the shell wins over this file.

# mock or openai
OCR_PROVIDER=mock
# needed when OCR_PROVIDER=openai
OPENAI_API_KEY=

# Defaults, uncomment to change
# PORT=3000
# OCR_TIMEOUT_MS=10000
# MAX_IMAGE_MB=10
# MAX_BODY_MB=14
# BLUR_CUTOFF=40
# MAX_READING=999999.9
